<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Necesario para abrir el instalador con el APK descargado -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Reproducción en segundo plano (radios y audio) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Descubrir Chromecasts en la red local (botón de Cast del reproductor).
         NEARBY_WIFI_DEVICES es el que pide Android 13+; neverForLocation evita
         que además haga falta pedir permiso de ubicación, que es lo que exigía
         antes para lo mismo. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Permite que la app se instale y se vea en el launcher de Android TV -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <!-- Ventanita flotante (PiP) al salir de la app mientras se reproduce video -->
    <uses-feature
        android:name="android.software.picture-in-picture"
        android:required="false" />

    <!--
        ICONOS

        android:icon / android:roundIcon  -> escritorio del movil. Apuntan al
        icono adaptativo de mipmap-anydpi-v26, que el sistema recorta con la
        forma de cada lanzador (circulo, cuadrado redondeado, squircle).

        android:banner -> fila de aplicaciones de Android TV. Tiene que ser un
        rectangulo de 320x180; antes apuntaba al icono cuadrado del escritorio y
        por eso PlayMix TV salia como un cuadradito con el nombre debajo,
        mientras las demas apps mostraban una tarjeta ancha.
    -->
    <!--
        COPIA DE SEGURIDAD

        Sigue activada (favoritos, historial y ajustes se conservan al cambiar
        de aparato), pero con reglas: miiptv_prefs queda excluido porque ahí
        vive la contraseña del panel en texto plano. Sin estas dos lineas
        Android la subiria a Google Drive.

        Hacen falta las dos: fullBackupContent lo lee Android 5.0-11 y
        dataExtractionRules lo lee Android 12 en adelante.
    -->
    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.MiIPTV"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">
        <!--
            usesCleartextTraffic sigue acá para Android 7 y anteriores (API
            21-23), que no leen networkSecurityConfig. De API 24 en
            adelante manda el archivo, que es más fino: deja HTTP para los
            paneles del usuario pero lo prohíbe en los dominios fijos de la
            app (ver network_security_config.xml).
        -->

        <!-- Le dice al SDK de Cast a qué receptor mandar el video. Ver
             CastOptionsProvider.kt para el motivo de usar el de Google en
             vez de uno propio. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.miiptv.app.util.CastOptionsProvider" />

        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.MiIPTV.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.DeviceModeActivity" android:exported="false" />
        <activity android:name=".ui.LoginActivity" android:exported="false" />
        <activity android:name=".ui.MainActivity" android:exported="false" />
        <activity
            android:name=".ui.PlayerActivity"
            android:exported="false"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode" />
        <activity android:name=".ui.SearchActivity" android:exported="false" />
        <activity android:name=".ui.SeriesDetailActivity" android:exported="false" />
        <activity android:name=".ui.ParentalSettingsActivity" android:exported="false" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.PersonalizeActivity" android:exported="false" />

        <service
            android:name=".service.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <activity android:name=".ui.MovieDetailActivity" android:exported="false" />
        <activity
            android:name=".ui.MultiScreenActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="landscape" />


        <!-- Entrega el APK descargado al instalador del sistema -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

    </application>

</manifest>
