<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Necesario para abrir el instalador con el APK descargado -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Reproducción en segundo plano (radios y audio) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Permite que la app se instale y se vea en el launcher de Android TV -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <!-- Ventanita flotante (PiP) al salir de la app mientras se reproduce video -->
    <uses-feature
        android:name="android.software.picture-in-picture"
        android:required="false" />

    <!--
        ICONOS

        android:icon / android:roundIcon  -> escritorio del movil. Apuntan al
        icono adaptativo de mipmap-anydpi-v26, que el sistema recorta con la
        forma de cada lanzador (circulo, cuadrado redondeado, squircle).

        android:banner -> fila de aplicaciones de Android TV. Tiene que ser un
        rectangulo de 320x180; antes apuntaba al icono cuadrado del escritorio y
        por eso PlayMix TV salia como un cuadradito con el nombre debajo,
        mientras las demas apps mostraban una tarjeta ancha.
    -->
    <application
        android:allowBackup="true"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.MiIPTV"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.MiIPTV.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.DeviceModeActivity" android:exported="false" />
        <activity android:name=".ui.LoginActivity" android:exported="false" />
        <activity android:name=".ui.MainActivity" android:exported="false" />
        <activity
            android:name=".ui.PlayerActivity"
            android:exported="false"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode" />
        <activity android:name=".ui.SearchActivity" android:exported="false" />
        <activity android:name=".ui.SeriesDetailActivity" android:exported="false" />
        <activity android:name=".ui.ParentalSettingsActivity" android:exported="false" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.PersonalizeActivity" android:exported="false" />

        <service
            android:name=".service.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <activity android:name=".ui.MovieDetailActivity" android:exported="false" />
        <activity
            android:name=".ui.MultiScreenActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="landscape" />


        <!-- Entrega el APK descargado al instalador del sistema -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

    </application>

</manifest>
