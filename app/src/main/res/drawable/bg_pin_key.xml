<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Tecla recién tocada: mismo "vidrio" pero con borde dorado, como el resto
         de los estados activos/seleccionados de la app (favoritos, chip elegido). -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/glass_card" />
            <stroke android:width="2dp" android:color="@color/star_active" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/glass_card" />
            <stroke android:width="0.6dp" android:color="@color/glass_border" />
        </shape>
    </item>
</selector>
