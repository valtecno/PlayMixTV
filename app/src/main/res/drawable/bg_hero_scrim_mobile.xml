<?xml version="1.0" encoding="utf-8"?>
<!-- Velo del banner en móvil: la carátula ocupa todo y el texto va abajo,
     sobre una base oscura que sube desde el borde inferior. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="90"
        android:startColor="#F20A0A0F"
        android:centerColor="#8C0A0A0F"
        android:endColor="#00000000" />
</shape>
