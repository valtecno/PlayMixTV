<?xml version="1.0" encoding="utf-8"?>
<!--
    Fondo del icono adaptativo.

    Antes era un color plano (@color/brand_primary_dark). Ahora es el mismo
    degradado diagonal que usa el fondo de la app, así el icono se lee como
    parte de PlayMix TV y no como un cuadrado oscuro cualquiera.

    Va en XML y no en PNG a propósito: el sistema dibuja este fondo a tamaños
    muy distintos (48dp en el escritorio, más de 190dp en Ajustes o en el
    selector de apps) y un degradado lineal se estira sin perder nitidez ni
    cambiar de aspecto. Un radial, en cambio, se vería descentrado al ampliarse.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#2E1550"
        android:centerColor="#170C2B"
        android:endColor="#0B0714" />
</shape>
