<?xml version="1.0" encoding="utf-8"?>
<!-- Botón secundario del banner: con foco se rellena de blanco translúcido y lleva anillo blanco. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#4DFFFFFF" />
            <corners android:radius="10dp" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <corners android:radius="10dp" />
            <stroke android:width="3dp" android:color="#B3FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1FFFFFFF" />
            <corners android:radius="10dp" />
            <stroke android:width="3dp" android:color="#59FFFFFF" />
        </shape>
    </item>
</selector>
