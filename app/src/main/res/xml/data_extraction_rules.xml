<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ reemplazó fullBackupContent por esto y separó dos casos que
    antes iban juntos. Hay que declarar los dos o el que falte se queda con el
    comportamiento por defecto, que es respaldarlo TODO:

      cloud-backup   -> lo que se sube a Google Drive.
      device-transfer -> copia directa de un teléfono al nuevo, sin pasar por
                         la nube (cable o wifi durante la configuración).

    En los dos se excluye miiptv_prefs por el mismo motivo que en
    backup_rules.xml: ahí está la contraseña del panel (cifrada, pero sin
    necesidad de que salga del aparato).

    device-transfer podría discutirse — no sale a internet, va de un aparato del
    usuario a otro. Se excluye igual porque la ganancia es escribir la
    contraseña una vez menos, y no vale la pena tener dos criterios distintos
    para el mismo archivo.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="miiptv_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="miiptv_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
