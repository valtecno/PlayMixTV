<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="true"
        app:show_timeout="4000"
        app:controller_layout_id="@layout/custom_player_control_view"
        app:show_rewind_button="true"
        app:show_fastforward_button="true"
        app:show_next_button="false"
        app:show_previous_button="false"
        app:show_shuffle_button="false"
        app:repeat_toggle_modes="none" />

    <!--
      ===== Pantalla de Radios ("Aurora en vivo") =====
      Las emisoras no traen imagen, así que en lugar del PlayerView se muestra
      esto: un fondo de luces difusas con el color de la emisora, la ficha de
      la emisora a un lado y el reloj, la fecha y la temperatura en grande al
      otro. Las animaciones (aurora, anillos, onda) las maneja RadioScene y se
      apagan solas en modo equipo débil, al pausar y al salir de la pantalla.
    -->
    <FrameLayout
        android:id="@+id/radioBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0E0818"
        android:visibility="gone">

        <!-- Aurora: tres manchas de luz (degradados radiales armados por código)
             que se desplazan muy lento. Solo se mueven, no se redibujan. -->
        <FrameLayout
            android:id="@+id/radioAurora"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <View
                android:id="@+id/aurora1"
                android:layout_width="560dp"
                android:layout_height="560dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="-160dp"
                android:layout_marginTop="-180dp" />

            <View
                android:id="@+id/aurora2"
                android:layout_width="520dp"
                android:layout_height="520dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="-140dp"
                android:layout_marginBottom="-180dp" />

            <View
                android:id="@+id/aurora3"
                android:layout_width="460dp"
                android:layout_height="460dp"
                android:layout_gravity="top|end"
                android:layout_marginEnd="60dp"
                android:layout_marginTop="-200dp" />
        </FrameLayout>

        <!-- Oscurece el pie para que la barra de reproducción se despegue -->
        <View
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_radio_scrim"
            android:rotation="180" />

        <!-- Ondas finas sobre la barra de reproducción -->
        <com.miiptv.app.ui.RadioWaveView
            android:id="@+id/radioWave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="62dp" />

        <!-- Dos columnas: emisora | reloj. En un teléfono vertical RadioScene
             las apila (emisora arriba, reloj abajo). -->
        <LinearLayout
            android:id="@+id/radioColumns"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="64dp"
            android:layout_marginBottom="96dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <!-- ===== Columna de la emisora =====
                 FitScaleLayout mide el contenido a su tamaño natural y, si no
                 cabe en el alto disponible, lo achica entero en vez de cortarlo. -->
            <com.miiptv.app.ui.FitScaleLayout
                android:id="@+id/colRadioStation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- Logo con halo y dos anillos que laten mientras suena -->
                <!-- El halo de color es el fondo de este contenedor (RadioScene) -->
                <FrameLayout
                    android:id="@+id/radioLogoBox"
                    android:layout_width="170dp"
                    android:layout_height="170dp"
                    android:clipChildren="false">

                    <View
                        android:id="@+id/radioRing2"
                        android:layout_width="164dp"
                        android:layout_height="164dp"
                        android:layout_gravity="center" />

                    <View
                        android:id="@+id/radioRing1"
                        android:layout_width="136dp"
                        android:layout_height="136dp"
                        android:layout_gravity="center" />

                    <FrameLayout
                        android:id="@+id/radioLogoHolder"
                        android:layout_width="108dp"
                        android:layout_height="108dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_radio_glass_circle">

                        <ImageView
                            android:id="@+id/ivRadioLogo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="26dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_radio"
                            android:contentDescription="@string/section_radio" />
                    </FrameLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/tvRadioName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="@color/text_light"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- Chip de vidrio: ecualizador + EN VIVO -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_radio_glass_pill"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:id="@+id/equalizer"
                        android:layout_width="wrap_content"
                        android:layout_height="14dp"
                        android:orientation="horizontal"
                        android:gravity="bottom">

                        <View style="@style/EqBar" />
                        <View style="@style/EqBar" />
                        <View style="@style/EqBar" />
                        <View style="@style/EqBar" />
                        <View style="@style/EqBar" />
                    </LinearLayout>

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_live_dot" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:letterSpacing="0.09"
                        android:text="@string/radio_live"
                        android:textColor="@color/text_light"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Origen de la emisora. Ya no se muestra (la barra de abajo
                     dice "Emisora X de N"), pero se conserva por el código. -->
                <TextView
                    android:id="@+id/tvRadioMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <!-- "Sonando ahora": artista y canción, solo si la emisora los
                     envía. Oculta si no hay dato. -->
                <LinearLayout
                    android:id="@+id/radioNowCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_radio_glass_card"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="9dp"
                    android:paddingBottom="10dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvRadioNowLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="@string/radio_now_playing"
                        android:textColor="@color/brand_primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRadioSong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:singleLine="true"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:textColor="@color/text_light"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Botones redondos: Inicio y Favorito -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <ImageView
                            android:id="@+id/btnRadioHome"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:padding="13dp"
                            android:src="@drawable/ic_home"
                            android:focusable="true"
                            android:clickable="true"
                            android:contentDescription="@string/nav_home" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/nav_home"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/radioFavGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="34dp"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <ImageView
                            android:id="@+id/btnRadioFavorite"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:padding="13dp"
                            android:background="@drawable/bg_radio_glass_button"
                            android:src="@drawable/ic_favorite"
                            android:focusable="true"
                            android:clickable="true"
                            android:contentDescription="@string/radio_fav_add" />

                        <TextView
                            android:id="@+id/tvRadioFavLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/radio_fav_add"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            </com.miiptv.app.ui.FitScaleLayout>

            <!-- Separador tenue entre columnas (horizontal en vertical) -->
            <View
                android:id="@+id/radioDivider"
                android:layout_width="1dp"
                android:layout_height="260dp"
                android:background="#26FFFFFF" />

            <!--
              ===== Columna del reloj (protagonista) =====
              TextClock se refresca solo: no hace falta código ni Handler.
              format24Hour fuerza 24 horas sin depender de la región.
            -->
            <!-- El resplandor violeta es el fondo de esta columna (RadioScene) -->
            <com.miiptv.app.ui.FitScaleLayout
                android:id="@+id/colRadioClock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <TextClock
                    android:id="@+id/tvRadioClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format24Hour="HH:mm"
                    android:format12Hour="HH:mm"
                    android:fontFamily="sans-serif-thin"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/text_light"
                    android:textSize="104sp" />

                <TextClock
                    android:id="@+id/tvRadioClockDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:format24Hour="EEEE d 'de' MMMM"
                    android:format12Hour="EEEE d 'de' MMMM"
                    android:fontFamily="sans-serif-light"
                    android:textColor="#E6DEF5"
                    android:textSize="22sp" />

                <View
                    android:layout_width="180dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:background="#33FFFFFF" />

                <!-- Temperatura local del usuario (ver WeatherService) -->
                <TextView
                    android:id="@+id/tvRadioTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:drawableStart="@drawable/ic_thermometer"
                    android:drawablePadding="10dp"
                    android:fontFamily="sans-serif-light"
                    android:gravity="center_vertical"
                    android:textColor="@color/text_light"
                    android:textSize="34sp"
                    android:visibility="gone"
                    tools:text="18°C"
                    tools:visibility="visible" />
            </LinearLayout>
            </com.miiptv.app.ui.FitScaleLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ===== Overlay "Reproduciendo en <dispositivo>" =====
         Tapa el video (o el fondo de radio) mientras el contenido se está
         mandando a un Chromecast; el audio/video real ya no sale por acá,
         sale por el receptor, así que mostrar el PlayerView tal cual
         quedaría negro o congelado en el último cuadro. Va DESPUÉS de
         playerView/radioBackdrop (los tapa) pero ANTES de topBar (que se ve
         encima, para poder volver o cortar el cast desde ahí). -->
    <LinearLayout
        android:id="@+id/castOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_cast_connected"
            app:tint="@color/brand_accent"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvCastingTo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="@color/text_light"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            tools:text="Reproduciendo en Living" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/player_cast_hint"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- ===== Barra superior propia: título, favorito, opciones ===== -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#B3000000"
        android:paddingStart="8dp"
            android:paddingEnd="8dp"
        android:paddingTop="8dp"
            android:paddingBottom="8dp">

        <!-- Botón de volver, en la misma línea de diseño que el de Inicio -->
        <TextView
            android:id="@+id/btnBack"
            style="@style/NavItem"
            android:text="@string/back"
            android:drawableStart="@drawable/ic_back"
            android:contentDescription="@string/back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNowPlaying"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:textColor="@color/text_light"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- "Ahora" + "Luego", en un solo renglón; se oculta si el canal no tiene EPG vigente. -->
            <TextView
                android:id="@+id/tvEpgNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Zapping de canales en vivo: solo visibles si la lista trae más de un canal -->
        <ImageView
            android:id="@+id/btnZapPrev"
            style="@style/PlayerIcon"
            android:src="@drawable/ic_channel_down"
            android:visibility="gone"
            android:contentDescription="@string/zap_prev" />

        <ImageView
            android:id="@+id/btnLastChannel"
            style="@style/PlayerIcon"
            android:src="@drawable/ic_history"
            android:visibility="gone"
            android:contentDescription="@string/zap_last" />

        <ImageView
            android:id="@+id/btnZapNext"
            style="@style/PlayerIcon"
            android:src="@drawable/ic_channel_up"
            android:visibility="gone"
            android:contentDescription="@string/zap_next" />

        <ImageView
            android:id="@+id/btnFavorite"
            style="@style/PlayerIcon"
            android:src="@android:drawable/star_big_off"
            android:contentDescription="@string/tab_favorites" />

        <ImageView
            android:id="@+id/btnAudio"
            style="@style/PlayerIcon"
            android:src="@drawable/ic_audio"
            android:contentDescription="@string/player_audio" />

        <ImageView
            android:id="@+id/btnSubtitles"
            style="@style/PlayerIcon"
            android:src="@drawable/ic_subtitles"
            android:contentDescription="@string/player_subtitles" />

        <ImageView
            android:id="@+id/btnVolume"
            style="@style/PlayerIcon"
            android:src="@drawable/ic_volume_up"
            android:contentDescription="@string/player_volume" />

        <!--
            Botón de Cast estándar de Google. No es un ImageView como el
            resto de los íconos de esta barra: es un widget propio del SDK
            (androidx.mediarouter) que se pinta y se actualiza solo; Google
            decide su apariencia (el ícono "cast" de siempre, tachado cuando
            está conectado) y no conviene tocarlo desde acá. El tamaño se
            ajusta para que quede a la par del resto (ver PlayerIcon).

            A propósito NO se le fuerza color por XML (existió un intento con
            un atributo "mediaRouteButtonTint" que en realidad no es un
            atributo real de este widget): mejor dejarlo con su apariencia
            de fábrica, que ya se ve bien sobre este fondo oscuro, que
            arriesgar un atributo inventado y romper la compilación.
        -->
        <androidx.mediarouter.app.MediaRouteButton
            android:id="@+id/btnCast"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/player_cast" />

        <ImageView
            android:id="@+id/btnAspect"
            style="@style/PlayerIcon"
            android:src="@drawable/ic_fit_screen"
            android:contentDescription="@string/setting_aspect" />

        <ImageView
            android:id="@+id/btnBuffer"
            style="@style/PlayerIcon"
            android:src="@drawable/ic_buffer"
            android:contentDescription="@string/setting_buffer" />

        <ImageView
            android:id="@+id/btnSleep"
            style="@style/PlayerIcon"
            android:src="@drawable/ic_sleep"
            android:contentDescription="@string/sleep_timer" />

        <ImageView
            android:id="@+id/btnLock"
            style="@style/PlayerIcon"
            android:src="@drawable/ic_lock_open"
            android:contentDescription="@string/player_lock" />

    </LinearLayout>

    <!-- ===== Barra de volumen: canales y PPV (incluye Favoritos y Niños,
         que abren estas mismas pantallas) =====
         Oculta hasta tocar btnVolume. El SeekBar mueve Player.volume (el del
         reproductor, no el del sistema): no toca los botones físicos del
         control ni el volumen de otras apps, y arranca cada canal con el
         nivel que se dejó la vez anterior (PlayerPrefs). -->
    <LinearLayout
        android:id="@+id/volumeBar"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="72dp"
        android:layout_marginEnd="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_glass_card"
        android:paddingStart="16dp"
            android:paddingEnd="16dp"
        android:paddingTop="4dp"
            android:paddingBottom="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivVolumeIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_volume_up"
            android:contentDescription="@null" />

        <SeekBar
            android:id="@+id/sbVolume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:max="100"
            android:progress="100"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvVolumePercent"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/text_light"
            android:textSize="12sp"
            tools:text="100%" />

    </LinearLayout>

    <!-- ===== Botón para desbloquear, visible solo con la pantalla bloqueada ===== -->
    <ImageView
        android:id="@+id/btnUnlock"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="18dp"
        android:padding="12dp"
        android:background="#99000000"
        android:src="@drawable/ic_lock_closed"
        android:visibility="gone"
        android:contentDescription="@string/player_unlock" />

    <!-- ===== Aviso de siguiente episodio ===== -->
    <LinearLayout
        android:id="@+id/nextEpisodeBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="90dp"
        android:orientation="vertical"
        android:background="@drawable/bg_glass_card"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvNextCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_light"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/btnPlayNextNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
            android:paddingEnd="18dp"
                android:paddingTop="9dp"
            android:paddingBottom="9dp"
                android:text="@string/player_next"
                android:textColor="@color/text_light"
                android:textStyle="bold"
                android:textSize="13sp"
                android:focusable="true"
                android:clickable="true" />

            <TextView
                android:id="@+id/btnCancelNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_option"
                android:paddingStart="18dp"
            android:paddingEnd="18dp"
                android:paddingTop="9dp"
            android:paddingBottom="9dp"
                android:text="@string/cancel"
                android:textColor="@color/text_light"
                android:textSize="13sp"
                android:focusable="true"
                android:clickable="true" />
        </LinearLayout>
    </LinearLayout>

    <!--
      ===== Barra de reproducción de radio =====
      Qué emisora suena (logo + nombre) y los botones para saltar a la
      anterior o la siguiente sin volver a la lista.
    -->
    <LinearLayout
        android:id="@+id/radioBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
        android:layout_marginBottom="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_radio_bar"
        android:padding="10dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivBarLogo"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_radio_logo_small"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_radio"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBarName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:textColor="@color/text_light"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBarSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnPrevStation"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_prev_station"
            android:background="@android:color/transparent"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="@string/radio_prev_station" />

        <ImageView
            android:id="@+id/btnRadioPlayPause"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:padding="13dp"
            android:src="@drawable/ic_radio_pause"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="@string/player_play_pause" />

        <ImageView
            android:id="@+id/btnNextStation"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_next_station"
            android:background="@android:color/transparent"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="@string/radio_next_station" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

</FrameLayout>
