<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <!-- Logo de la aplicación -->
    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/logo_playmix"
        android:contentDescription="@string/app_name" />

    <!-- Nombre de la aplicación -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/text_light"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <!-- Texto de instrucción -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ingresa tu código de acceso en el TV"
        android:textAlignment="center"
        android:textColor="@color/text_muted"
        android:textSize="15sp"
        android:layout_marginBottom="12dp" />

    <!-- NUEVO: Única casilla para el código PIN -->
    <EditText
        android:id="@+id/etPinCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ej: 8B4F9"
        android:gravity="center"
        android:textColor="@color/text_light"
        android:textColorHint="@color/text_muted"
        android:background="@drawable/bg_glass_card"
        android:padding="16dp"
        android:textSize="22sp"
        android:maxLength="6"
        android:inputType="textCapCharacters"
        android:layout_marginBottom="32dp"
        android:importantForAutofill="no" />

    <!-- Botón de Entrar -->
    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_login"
        android:background="@drawable/bg_button_gradient"
        android:textColor="@color/text_light"
        android:padding="14dp"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Círculo de carga oculto -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:visibility="gone" />

</LinearLayout>
</ScrollView>