<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/logo_playmix"
        android:contentDescription="@string/app_name" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/text_light"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hint_choose_server"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:id="@+id/serverChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="28dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hint_access_code_label"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <!-- Campo único de código. etUsername queda en el layout pero oculto:
         el sistema de validación lo necesita internamente (el servidor
         privado recibe el código y decide qué usuario asignar). -->
    <EditText
        android:id="@+id/etUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:importantForAutofill="no" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp">

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_access_code"
            android:textColor="@color/text_light"
            android:textColorHint="@color/text_muted"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:background="@drawable/bg_glass_card"
            android:padding="18dp"
            android:textSize="18sp"
            android:gravity="center"
            android:letterSpacing="0.15"
            android:importantForAutofill="no" />

        <!-- btnTogglePassword se mantiene en el layout (el binding lo referencia)
             pero oculto: no hay nada que mostrar/ocultar en un código. -->
        <ImageView
            android:id="@+id/btnTogglePassword"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:visibility="gone"
            android:contentDescription="@null" />

    </FrameLayout>

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_login"
        android:background="@drawable/bg_button_gradient"
        android:textColor="@color/text_light" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

</LinearLayout>
</ScrollView>
