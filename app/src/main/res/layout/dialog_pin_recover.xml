<?xml version="1.0" encoding="utf-8"?>
<!-- Recuperar PIN olvidado. En celular: botón que abre WhatsApp. En TV (donde
     no hay WhatsApp): un código QR para escanear con el celular. PinDialog
     muestra uno u otro según el modo del aparato. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pin_recover_title"
            android:textColor="@color/text_light"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/pin_recover_message"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <!-- Solo en TV -->
        <ImageView
            android:id="@+id/ivPinRecoverQr"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/img_qr_recuperar_pin"
            android:contentDescription="@string/pin_recover_qr_hint"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvPinRecoverQrHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/pin_recover_qr_hint"
            android:textColor="@color/text_light"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Solo en celular -->
        <TextView
            android:id="@+id/btnPinRecoverWhatsapp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_gradient"
            android:gravity="center"
            android:paddingTop="13dp"
            android:paddingBottom="13dp"
            android:text="@string/pin_recover_whatsapp"
            android:textColor="@color/text_light"
            android:textSize="15sp"
            android:textStyle="bold"
            android:focusable="true"
            android:clickable="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnPinRecoverClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_option"
            android:gravity="center"
            android:paddingTop="13dp"
            android:paddingBottom="13dp"
            android:text="@string/pin_recover_back"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:focusable="true"
            android:clickable="true" />
    </LinearLayout>
</ScrollView>
