<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:title=""
        android:titleTextColor="@color/text_light"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivToolbarLogo"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="10dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:src="@drawable/logo_playmix" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvToolbarTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_light" />

                <TextView
                    android:id="@+id/tvToolbarBy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-2dp"
                    android:text="@string/app_author"
                    android:textSize="10sp"
                    android:letterSpacing="0.04"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <!-- ===== Menú de secciones + saludo/vencimiento, todo en una sola línea ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:paddingBottom="8dp">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none"
            android:requiresFadingEdge="horizontal"
            android:fadingEdgeLength="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="10dp">

                <TextView android:id="@+id/navHome" style="@style/NavItem"
                    android:text="@string/nav_home" android:drawableStart="@drawable/ic_home" />

                <TextView android:id="@+id/navLive" style="@style/NavItem"
                    android:text="@string/tab_live" android:drawableStart="@drawable/ic_live" />

                <TextView android:id="@+id/navMovies" style="@style/NavItem"
                    android:text="@string/tab_movies" android:drawableStart="@drawable/ic_movie" />

                <TextView android:id="@+id/navSeries" style="@style/NavItem"
                    android:text="@string/tab_series" android:drawableStart="@drawable/ic_series" />

                <TextView android:id="@+id/navRadio" style="@style/NavItem"
                    android:text="@string/nav_radio" android:drawableStart="@drawable/ic_radio" />

                <TextView android:id="@+id/navPpv" style="@style/NavItem"
                    android:text="@string/nav_ppv" android:drawableStart="@drawable/ic_ball" />

                <TextView android:id="@+id/navFavorites" style="@style/NavItem"
                    android:text="@string/tab_favorites" android:drawableStart="@drawable/ic_favorite" />

                <TextView android:id="@+id/navKids" style="@style/NavItem"
                    android:text="@string/nav_kids" android:drawableStart="@drawable/ic_kids" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Indica que el menú sigue hacia la derecha -->
        <ImageView
            android:id="@+id/navScrollHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_chevron_right"
            android:contentDescription="@null"
            android:alpha="0.6" />


    </LinearLayout>

    <!-- ===== Inicio: dos secciones lado a lado, un póster por vez ===== -->
    <LinearLayout
        android:id="@+id/homeSections"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:visibility="gone">

        <!-- Izquierda: Novedades -->
        <LinearLayout
            android:id="@+id/colNovedades"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCarouselTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="6dp"
                android:text="@string/carousel_title"
                android:textColor="@color/text_light"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerCarousel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingStart="6dp"
                android:paddingEnd="6dp" />
        </LinearLayout>

        <!-- Derecha: Agregado recientemente -->
        <LinearLayout
            android:id="@+id/colRecientes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRecentTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="6dp"
                android:text="@string/section_recent"
                android:textColor="@color/text_light"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerRecent"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingStart="6dp"
                android:paddingEnd="6dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Buscador dedicado del perfil de niños ===== -->
    <EditText
        android:id="@+id/etKidsSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_glass_card"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:hint="@string/kids_search_hint"
        android:textColor="@color/text_light"
        android:textColorHint="@color/text_muted"
        android:textCursorDrawable="@null"
        android:inputType="text"
        android:maxLines="1"
        android:imeOptions="actionSearch"
        android:visibility="gone" />

    <!-- ===== Buscador propio de PPV ===== -->
    <EditText
        android:id="@+id/etPpvSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_glass_card"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:hint="@string/ppv_search_hint"
        android:textColor="@color/text_light"
        android:textColorHint="@color/text_muted"
        android:textCursorDrawable="@null"
        android:inputType="text"
        android:maxLines="1"
        android:imeOptions="actionSearch"
        android:visibility="gone" />

    <!-- ===== Filtros por tipo dentro de Favoritos ===== -->
    <HorizontalScrollView
        android:id="@+id/favFilterScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingBottom="8dp"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/favFilterContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </HorizontalScrollView>

    <!-- ===== Cuerpo: lista de la sección + panel de previsualización (Canales en TV) ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/listColumn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- ===== Categorías (secciones de catálogo) ===== -->
            <HorizontalScrollView
                android:id="@+id/categoryScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingTop="4dp"
                android:paddingBottom="8dp">
                <LinearLayout
                    android:id="@+id/categoryContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvSectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="6dp"
                android:textColor="@color/text_light"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="40dp" />

            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:textColor="@color/text_muted"
                android:visibility="gone"
                android:text="@string/empty_list" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerChannels"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:padding="8dp" />

        </LinearLayout>

        <!-- ===== Previsualización: se ve solo en Canales, en TV (control remoto) =====
             Muestra el canal recién enfocado sin cortar la reproducción actual;
             hay que tocar "Reproducir" para recién ahí abrir el reproductor. -->
        <LinearLayout
            android:id="@+id/previewPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.4"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/previewThumbFrame"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_card"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivPreviewLogo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:padding="24dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvPreviewLive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_live_badge"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="@string/preview_live"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/btnPreviewPlay"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_play_circle"
                        android:padding="18dp"
                        android:src="@drawable/ic_play_arrow"
                        android:contentDescription="@string/preview_play" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/preview_play"
                        android:textColor="@color/text_light"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </FrameLayout>

            <TextView
                android:id="@+id/tvPreviewTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/text_light"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPreviewCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
