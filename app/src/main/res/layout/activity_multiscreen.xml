<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout android:id="@+id/slot0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#111111">
            <androidx.media3.ui.PlayerView android:id="@+id/player0" android:layout_width="match_parent" android:layout_height="match_parent" app:use_controller="false" />
        </FrameLayout>

        <FrameLayout android:id="@+id/slot1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#111111" android:layout_marginStart="2dp">
            <androidx.media3.ui.PlayerView android:id="@+id/player1" android:layout_width="match_parent" android:layout_height="match_parent" app:use_controller="false" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <FrameLayout android:id="@+id/slot2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#111111">
            <androidx.media3.ui.PlayerView android:id="@+id/player2" android:layout_width="match_parent" android:layout_height="match_parent" app:use_controller="false" />
        </FrameLayout>

        <FrameLayout android:id="@+id/slot3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#111111" android:layout_marginStart="2dp">
            <androidx.media3.ui.PlayerView android:id="@+id/player3" android:layout_width="match_parent" android:layout_height="match_parent" app:use_controller="false" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
