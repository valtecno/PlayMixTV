<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Resplandor detrás del logo. Va antes que animatedIntro para quedar por
         debajo, y centrado en el mismo punto que el logo. Arranca invisible: lo
         enciende y lo apaga la animación de SplashActivity. -->
    <View
        android:id="@+id/introGlow"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center"
        android:layout_marginBottom="70dp"
        android:background="@drawable/bg_splash_glow"
        android:alpha="0" />

    <!-- Intro animado por código (logo + nombre). Se usa mientras no exista res/raw/intro.mp4 -->
    <LinearLayout
        android:id="@+id/animatedIntro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/ivLogoFallback"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/logo_playmix"
            android:contentDescription="@string/app_name"
            android:alpha="0" />

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/app_name"
            android:textColor="@color/text_light"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:alpha="0" />

        <TextView
            android:id="@+id/tvSplashBy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="@string/app_author"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:letterSpacing="0.06"
            android:alpha="0" />

    </LinearLayout>

    <!-- Se muestra automáticamente si existe res/raw/intro.mp4 -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:use_controller="false"
        app:resize_mode="zoom" />

</FrameLayout>
