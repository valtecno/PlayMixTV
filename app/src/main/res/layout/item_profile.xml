<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:focusable="true"
    android:clickable="true"
    android:background="@android:color/transparent"
    android:stateListAnimator="@animator/scale_on_focus">

    <!-- Círculo de color con emoji del avatar -->
    <FrameLayout
        android:id="@+id/flAvatarBg"
        android:layout_width="130dp"
        android:layout_height="130dp">

        <!-- Fondo circular coloreado -->
        <View
            android:id="@+id/vAvatarCircle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_profile_avatar"/>

        <!-- Emoji del avatar centrado -->
        <TextView
            android:id="@+id/tvAvatarEmoji"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="54sp"
            android:includeFontPadding="false"/>

        <!-- Ícono de editar (lápiz), solo visible en modo edición) -->
        <ImageView
            android:id="@+id/ivEditOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_edit_overlay"
            android:visibility="gone"
            android:background="#88000000"
            android:padding="28dp"/>

        <!-- Botón visible de editar (nombre / avatar). No perfil Niños. -->
        <ImageView
            android:id="@+id/ivEditBadge"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_edit_badge"
            android:src="@drawable/ic_edit_overlay"
            android:padding="7dp"
            android:clickable="true"
            android:focusable="false"
            android:contentDescription="@string/profile_edit_title"/>

        <!-- Botón de eliminar (papelera), esquina superior izquierda. No perfil Niños. -->
        <ImageView
            android:id="@+id/ivDeleteBadge"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|start"
            android:layout_margin="4dp"
            android:background="@drawable/bg_edit_badge"
            android:src="@drawable/ic_delete"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="false"
            android:contentDescription="@string/profile_delete"
            android:visibility="gone"/>

    </FrameLayout>

    <!-- Nombre del perfil -->
    <TextView
        android:id="@+id/tvProfileName"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="#CCCCCC"
        android:textSize="16sp"
        android:maxLines="1"
        android:ellipsize="end"/>

</LinearLayout>
