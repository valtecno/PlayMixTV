<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:focusable="true"
    android:clickable="true"
    android:background="@android:color/transparent"
    android:stateListAnimator="@animator/scale_on_focus">

    <!-- Círculo de color con emoji del avatar -->
    <FrameLayout
        android:id="@+id/flAvatarBg"
        android:layout_width="130dp"
        android:layout_height="130dp">

        <!-- Fondo circular coloreado -->
        <View
            android:id="@+id/vAvatarCircle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_profile_avatar"/>

        <!-- Imagen del avatar (persona/ilustración) -->
        <ImageView
            android:id="@+id/ivAvatarImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"/>

        <!-- Emoji del avatar (fallback para KIDS u otros sin drawable) -->
        <TextView
            android:id="@+id/tvAvatarEmoji"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="54sp"
            android:includeFontPadding="false"
            android:visibility="gone"/>

        <!-- Ícono de editar (lápiz), solo visible en modo edición) -->
        <ImageView
            android:id="@+id/ivEditOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_edit_overlay"
            android:visibility="gone"
            android:background="#88000000"
            android:padding="28dp"/>

    </FrameLayout>

    <!-- Nombre del perfil -->
    <TextView
        android:id="@+id/tvProfileName"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="#CCCCCC"
        android:textSize="16sp"
        android:maxLines="1"
        android:ellipsize="end"/>

</LinearLayout>
