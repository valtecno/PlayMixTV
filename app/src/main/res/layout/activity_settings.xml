<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        android:title="@string/settings_title"
        android:titleTextColor="@color/text_light"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ===== Mi Perfil: primero, acceso rápido a perfiles y cuenta ===== -->
            <LinearLayout android:id="@+id/rowSwitchProfile" style="@style/SettingsRow">
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_account"
                    android:tint="@color/brand_primary"
                    android:scaleType="centerInside"
                    android:contentDescription="@null" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_manage"
                        android:textColor="@color/text_light"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/tvServer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/text_muted"
                    android:textSize="22sp" />
            </LinearLayout>

            <!-- ===== Ayuda: para que se encuentre sin buscarla ===== -->
            <LinearLayout android:id="@+id/rowHelp" style="@style/SettingsRow">
                <ImageView
                    android:id="@+id/ivHelpVanessa"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_avatar"
                    android:padding="1dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_vanessa_avatar"
                    android:contentDescription="@null" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_help"
                        android:textColor="@color/text_light"
                        android:textSize="15sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_help_desc"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/text_muted"
                    android:textSize="22sp" />
            </LinearLayout>

            <!-- ===== Reproductor ===== -->
            <TextView style="@style/SettingsHeader" android:text="@string/settings_player" />

            <LinearLayout android:id="@+id/rowBuffer" style="@style/SettingsRow">
                <TextView style="@style/SettingsLabel" android:text="@string/setting_buffer" />
                <TextView android:id="@+id/tvBuffer" style="@style/SettingsValue" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowAspect" style="@style/SettingsRow">
                <TextView style="@style/SettingsLabel" android:text="@string/setting_aspect" />
                <TextView android:id="@+id/tvAspect" style="@style/SettingsValue" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowReconnect" style="@style/SettingsRow">
                <TextView style="@style/SettingsLabel" android:text="@string/setting_reconnect" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swReconnect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowBackground" style="@style/SettingsRow">
                <TextView style="@style/SettingsLabel" android:text="@string/setting_background" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swBackground"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowAutoNext" style="@style/SettingsRow">
                <TextView style="@style/SettingsLabel" android:text="@string/setting_autoplay_next" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swAutoNext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowScreenOn" style="@style/SettingsRow">
                <TextView style="@style/SettingsLabel" android:text="@string/setting_screen_on" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swScreenOn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowDeviceMode" style="@style/SettingsRow">
                <TextView style="@style/SettingsLabel" android:text="@string/setting_device_mode" />
                <TextView android:id="@+id/tvDeviceMode" style="@style/SettingsValue" />
            </LinearLayout>

            <!-- ===== Contenido ===== -->
            <TextView style="@style/SettingsHeader" android:text="@string/settings_content" />

            <Button
                android:id="@+id/btnRefreshCatalog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_button_gradient"
                android:textColor="@color/text_light"
                android:text="@string/setting_refresh_action" />

            <!-- Recuento desglosado por tipo con iconos -->
            <LinearLayout
                android:id="@+id/rowRefresh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_glass_card"
                android:layout_marginBottom="8dp"
                android:focusable="true"
                android:clickable="true">

                <!-- Canales -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">
                    <TextView
                        android:id="@+id/tvCatalogLive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/brand_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:text="—" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="📺 Canales"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Separador -->
                <View
                    android:layout_width="0.6dp"
                    android:layout_height="match_parent"
                    android:background="@color/glass_border" />

                <!-- Películas -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">
                    <TextView
                        android:id="@+id/tvCatalogMovies"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/brand_accent"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:text="—" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="🎬 Películas"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Separador -->
                <View
                    android:layout_width="0.6dp"
                    android:layout_height="match_parent"
                    android:background="@color/glass_border" />

                <!-- Series -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">
                    <TextView
                        android:id="@+id/tvCatalogSeries"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/brand_purple"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:text="—" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="🎭 Series"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Dos botones independientes: Vaciar caché y Código de errores -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:id="@+id/rowClearCache"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:background="@drawable/bg_glass_card"
                    android:focusable="true"
                    android:clickable="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_clear_cache"
                        android:textColor="@color/text_light"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:ellipsize="end" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowCrashLog"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:background="@drawable/bg_glass_card"
                    android:focusable="true"
                    android:clickable="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_crash_log"
                        android:textColor="@color/text_light"
                        android:textSize="13sp"
                        android:gravity="center" />
                    <TextView
                        android:id="@+id/tvCrashLogState"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                </LinearLayout>

            </LinearLayout>

            <!-- ===== Cuenta ===== -->
            <TextView style="@style/SettingsHeader" android:text="@string/settings_account" />

            <!-- tvAccountCount se mantiene oculto para compatibilidad con el binding;
                 la lógica de cuenta y audio ahora vive en el menú del botón Perfiles. -->
            <TextView
                android:id="@+id/tvAccountCount"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- Actualización de la app (distinta de "Actualizar catálogo", que
                 refresca el contenido del servidor) -->
            <LinearLayout android:id="@+id/rowUpdate" style="@style/SettingsRow">
                <TextView style="@style/SettingsLabel" android:text="@string/setting_update" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_current_version_label"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp"
                        android:gravity="end" />
                    <TextView
                        android:id="@+id/tvUpdateState"
                        style="@style/SettingsValue" />
                </LinearLayout>
            </LinearLayout>

            <!-- rowDataSync oculto: "Respaldo de mi perfil" se movió al menú de Mi Perfil -->
            <LinearLayout
                android:id="@+id/rowDataSync"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone">
                <TextView android:id="@+id/tvDataSyncState"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_gradient"
                android:textColor="@color/text_light"
                android:text="@string/setting_logout" />

            <!-- tvVersion oculto: la versión ya aparece en la fila "Buscar actualización manual" -->
            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
