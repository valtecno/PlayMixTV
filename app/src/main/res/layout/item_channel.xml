<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_glass_card"
    android:focusable="true"
    android:clickable="true"
    android:foreground="?attr/selectableItemBackground"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="5dp"
    android:padding="12dp">

    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="#1E1533"
        android:scaleType="centerInside" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_light"
            android:textSize="16sp" />

        <!-- "Ahora" + "Luego", en un solo renglón; se oculta si el canal no tiene EPG vigente. -->
        <TextView
            android:id="@+id/tvEpgNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

    </LinearLayout>

    <ImageView
        android:id="@+id/ivLock"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="12dp"
        android:src="@android:drawable/ic_lock_lock"
        android:visibility="gone" />

    <!--
      Solo aparece en la fila de la radio que está sonando en preview (ver
      ContentAdapter.setPreviewing). Al tocarlo abre esa emisora a pantalla
      completa; como ya está sonando por PlaybackHolder, PlayerActivity se
      engancha al mismo reproductor sin reiniciar el stream.
    -->
    <TextView
        android:id="@+id/btnOpen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_button_gradient"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="@string/radio_open"
        android:textColor="@color/text_light"
        android:textSize="13sp"
        android:textStyle="bold"
        android:focusable="true"
        android:clickable="true"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/ivFavorite"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:padding="2dp"
        android:src="@android:drawable/star_big_off"
        android:background="?attr/selectableItemBackgroundBorderless" />

</LinearLayout>
