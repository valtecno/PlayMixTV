<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <item
        android:id="@+id/action_refresh"
        android:title="@string/action_refresh"
        android:icon="@drawable/ic_refresh"
        app:iconTint="@color/star_active"
        app:showAsAction="always" />

    <item
        android:id="@+id/action_search"
        android:title="@string/action_search"
        android:icon="@drawable/ic_search"
        app:iconTint="@color/text_light"
        app:showAsAction="always" />

    <!--
        Candado, multipantalla y cuenta: en TV se muestran sueltos (los decide
        onPrepareOptionsMenu con "sueltos"), y van en "always" a propósito.

        Con "ifRoom" quedaban a merced de cuánto ancho le calculara Android al
        Toolbar en cada aparato: en algunos decos con poco espacio, "cuenta"
        no entraba y Android la mandaba sola al desbordamiento (los tres
        puntos), dejando un ícono de más ahí sin que hiciera falta. Con
        "always" los tres se dibujan siempre en la barra, igual que ya hace el
        engranaje de abajo en móvil, y no queda ningún ítem "de sobra" que
        obligue a que aparezcan los tres puntos.
    -->
    <item
        android:id="@+id/action_parental"
        android:title="@string/action_parental"
        android:icon="@android:drawable/ic_lock_lock"
        app:iconTint="@color/text_light"
        app:showAsAction="always" />

    <item
        android:id="@+id/action_multi"
        android:title="@string/nav_multi"
        android:icon="@drawable/ic_multiscreen"
        app:iconTint="@color/text_light"
        app:showAsAction="always" />

    <item
        android:id="@+id/action_account"
        android:title="@string/action_account"
        android:icon="@drawable/ic_account"
        app:iconTint="@color/text_light"
        app:showAsAction="always" />

    <!--
        Engranaje: SOLO se muestra en modo móvil (lo decide onPrepareOptionsMenu).

        Reemplaza a los tres puntos del desbordamiento. Al no quedar ningún ítem
        fuera de la barra, Android deja de dibujar los tres puntos por su cuenta:
        no hay que ocultarlos, simplemente dejan de existir.

        Detrás de él se agrupan control parental, multipantalla y cuenta, que en
        móvil se ocultan de la barra. Así quedan exactamente tres iconos arriba:
        actualizar, lupa y engranaje, en ese orden.
    -->
    <item
        android:id="@+id/action_quick"
        android:title="@string/action_quick"
        android:icon="@drawable/ic_settings"
        app:iconTint="@color/text_light"
        app:showAsAction="always" />

    <!--
        Acceso a YouTube: solo existe acá, colgado del menú de PlayMix. No es un
        acceso propio de la app — abre la app oficial de YouTube si está
        instalada, o lleva a instalarla si no. Va al final para quedar como el
        icono más a la derecha, después del resto.
    -->
    <item
        android:id="@+id/action_youtube"
        android:title="@string/action_youtube"
        android:icon="@drawable/ic_youtube"
        app:iconTint="@color/text_light"
        app:showAsAction="always" />

</menu>
